# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string. Locally: postgresql://user:pass@localhost:5432/tuition_forum_dhaka
DATABASE_URL=

# ── Auth.js ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Cloudinary (file storage: photos, docs, payment proofs) ─
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Password hashing ─────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Email (transactional notifications — Phase 3+) ──────
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@tuitionforumdhaka.com

# ── Payment (display-only defaults; real values live in the
#    admin-editable PaymentSetting table, never hardcoded here) ─
# No payment secrets belong in environment variables — bKash/Nagad
# numbers are configured from Admin Dashboard → Payment Settings.
